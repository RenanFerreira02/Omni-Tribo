<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.omnitribo</groupId>
  <artifactId>api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>omnitribo-api</name>
  <description>Omni-Tribo Backend API</description>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.4.2</archunit.version>
    <springdoc.version>3.1.0</springdoc.version>
    <spotless.version>3.9.0</spotless.version>
    <spotbugs.version>4.10.3.0</spotbugs.version>
    <!-- Versão gerenciada pelo Spring Boot parent; declarada aqui para suprimir warning do Maven -->
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <!-- Segurança: não gerenciadas pelo Spring Boot BOM -->
    <jjwt.version>0.12.6</jjwt.version>
    <bouncycastle.version>1.80</bouncycastle.version>
    <bucket4j.version>8.10.1</bucket4j.version>
    <!-- Só de teste. Ver a nota na dependência: traz okhttp 5.x, que convive com o 4.x do
         Testcontainers porque este último o resolve por conta própria. -->
    <mockwebserver.version>5.4.0</mockwebserver.version>
    <!-- Só no profile `seguranca`; ver a nota lá embaixo sobre por que não entra no verify. -->
    <dependency-check.version>13.0.0</dependency-check.version>
    <!-- Só no profile `mutacao`. Mesma razão do de cima: fora do verify padrão. -->
    <pitest.version>1.25.9</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
  </properties>

  <dependencies>
    <!-- Segurança -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Argon2PasswordEncoder usa BouncyCastle para o algoritmo Argon2id.
         Declarada explicitamente: não é transitiva do spring-security-crypto. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>
    <!-- JWT RS256: api em compile, impl e jackson em runtime (SPI loading) -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Rate limiting token-bucket em memória (sem Redis — single instance MVP) -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <!-- Cache em memória da busca por proximidade (TTL 30s). Sem Redis, mesma decisão do
         bucket4j acima: instância única no MVP.
         Sem <version>: gerenciada pelo BOM do Spring Boot 4.1 (caffeine.version = 3.2.4).
         Sem spring-boot-starter-cache de propósito — @CacheEvict dispara DENTRO da transação,
         e a invalidação precisa acontecer depois do commit. Ver CacheMissoesProximas. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- Aspecto de auditoria (@Aspect / @AfterReturning).
         Em Spring Boot 4.x, AOP é ativado via aspectjweaver diretamente
         (spring-boot-starter-aop foi removido nesta versão). -->
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>

    <!-- Web -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Data -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-spatial</artifactId>
    </dependency>

    <!-- Observabilidade -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- OpenAPI / Swagger -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Análise estática — anotações @SuppressFBWarnings (compile-only) -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>4.10.3</version>
      <scope>provided</scope>
    </dependency>

    <!-- Build tooling -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Testes -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Necessário para TestRestTemplate no Boot 4 (RestTemplateBuilder migrou para este módulo) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      Servidor HTTP de verdade, em socket local, para os testes de resiliência. MockRestServiceServer
      (que a suíte já usa) casa expectativas e não CONTA requisições de forma utilizável para
      "o disjuntor parou de chamar" — a asserção central aqui é a contagem estagnada.
      Escolhido em vez do WireMock porque a última versão do WireMock é 4.0.0-beta.38, e beta não
      entra num projeto que precisa ser defendido oralmente.
    -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3-junit5</artifactId>
      <version>${mockwebserver.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Cobertura de código -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!--
            Gate de cobertura. Ambas as regras usam INSTRUCTION e não BRANCH, e isso é medição e não
            preferência: a cobertura de branch está em ~74%, então um gate de branch reprovaria o
            build no primeiro commit e a única saída seria relaxar a régua depois — exatamente o que
            as regras do projeto proíbem. Branch continua no relatório publicado, como evidência
            para ler, que é o papel que o CLAUDE.md já lhe atribui.
          -->
          <execution>
            <id>check-global</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <!--
            `element` é BUNDLE, e não PACKAGE, de propósito: o requisito é 85% AGREGADO no domínio.
            Uma regra por pacote reprovaria em qualquer `dominio` pequeno e menos coberto
            (notificacoes.dominio está em ~84%) sem que a cobertura do domínio como um todo tivesse
            caído — e o número que interessa é o do domínio como um todo. O `includes` restringe o
            bundle às classes de domínio.

            ATENÇÃO: um `includes` que não casa nada produz bundle vazio e o check passa POR VÁCUO.
            Este padrão foi verificado subindo o mínimo para 0.99 e confirmando que o build reprova
            citando a razão real medida.
          -->
          <execution>
            <id>check-dominio</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes>
                <include>com/omnitribo/*/dominio/**/*.class</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Formatação de código -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Análise estática -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <failOnError>true</failOnError>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Varredura de vulnerabilidades em dependências. Fica FORA do `verify` padrão de propósito.

      Desde a 9.0 o plugin consulta a API da NVD em vez do feed de dados, e sem `nvdApiKey` a
      atualização da base é lenta e sujeita a 403 por limite de taxa. Preso ao `verify`, todo
      `./mvnw verify` local passaria a baixar base de CVE — o oposto do build rápido que a suíte
      inteira depende para ser rodada a cada mudança.

      Uso:  ./mvnw -Pseguranca verify
      No CI: roda em security.yml, com NVD_API_KEY vindo de secret e cache do diretório de dados.
    -->
    <profile>
      <id>seguranca</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <configuration>
              <!-- 7.0 é o piso de CVSS v3 para severidade ALTA. Reprova alta e crítica. -->
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <suppressionFiles>
                <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
              </suppressionFiles>
              <!--
                A chave da NVD NÃO é configurada aqui, e a tentativa de fazê-lo foi o que ensinou o
                porquê: com `${env.NVD_API_KEY}` e a variável ausente, o plugin recebe string vazia e
                aborta com "Invalid API Key, length of 0". Ele não trata vazio como "sem chave".
                A chave entra pela propriedade de usuário que o próprio plugin expõe:

                  ./mvnw -Pseguranca verify -Dnvd.api.key=$NVD_API_KEY
              -->
              <!--
                Diretorio da base da NVD, FIXADO. O default do plugin e
                ${settings.localRepository}/org/owasp/dependency-check-data/<versao> — ou seja,
                dentro do ~/.m2 —, e o passo de cache do security.yml apontava para
                services/api/target/dependency-check-data, que o plugin nunca escreveu. O cache
                salvava um diretorio inexistente e toda execucao semanal rebaixava a base inteira:
                exatamente o 403 por limite de taxa que aquele passo diz existir para evitar.
                Verificado nesta maquina — a execucao de 2026-08-24 deixou odc.mv.db no ~/.m2 e
                target/ sem nenhum artefato do dependency-check.

                Fora de target/ de proposito: `./mvnw clean` e rotina aqui (o CLAUDE.md manda rodar
                ao renomear migration) e apagaria uma base que custa dezenas de minutos para
                rebaixar. Fora do ~/.m2 tambem, para nao disputar o mesmo diretorio com o cache que
                o `setup-java` ja mantem sobre o repositorio local.
              -->
              <dataDirectory>${user.home}/.dependency-check-data</dataDirectory>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
              </formats>
              <!-- Analisadores de ecossistemas que este repositório não usa no backend. Ligados,
                   só somam tempo de varredura sobre nada. -->
              <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
              <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
            </configuration>
            <executions>
              <execution>
                <id>dependency-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Teste de mutação (PIT). Fica FORA do `verify` padrão, pela mesma razão do `seguranca` acima:
      mutar exige reexecutar a suíte uma vez por mutante, e prender isso ao `verify` acabaria com o
      build rápido de que a suíte inteira depende para ser rodada a cada mudança.

      SEM GATE, de propósito — não há `mutationThreshold`. O CLAUDE.md registra a decisão: um gate
      reprovaria o build por mutante equivalente em getter e DTO, e o valor deste relatório está nos
      SOBREVIVENTES que ele nomeia, não na porcentagem. O número entra no relatório, não na porta.

      Escopo restrito a `missoes.dominio` e `carteira.dominio`: é onde o teste protege dinheiro e
      maquina de estados, e onde um teste sem assertion passaria despercebido.

      Uso:  ./mvnw -Pmutacao test -Djacoco.skip=true
      Saida: target/pit-reports/
    -->
    <profile>
      <id>mutacao</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.omnitribo.missoes.dominio.*</param>
                <param>com.omnitribo.carteira.dominio.*</param>
              </targetClasses>
              <!--
                `targetTests` NAO e restrito, e isso foi aprendido medindo. Restringi-lo aos pacotes
                `missoes.*` e `carteira.*` — o que parece obvio, ja que o alvo e o dominio deles —
                fez `AporteService` sair como NO_COVERAGE em 7 de 7 mutantes. Ele e o UNICO ponto de
                emissao de token do sistema e TEM teste: `PatrocinadorAdminTest`, que mora em
                `identidade.api`, fora do filtro. O mesmo valia para `debitarPatrocinador`, coberto
                pelo webhook em `logistica.api`.

                Ou seja: o filtro produzia um relatorio que acusava de intestado justamente o codigo
                mais sensivel do projeto — o espelho do `includes` vazio do JaCoCo, que passa por
                vacuo. Sem `targetTests`, PIT considera a suite inteira e roda por mutante apenas os
                testes que cobrem a linha mutada.
              -->
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <!--
                Timeout FOLGADO porque parte da suite-alvo sobe PostGIS por Testcontainers: o
                default (4000 ms + 25%) mataria o minion durante o start do container e o mutante
                seria contado como TIMEOUT, que se le como "morto" e nao e.
              -->
              <timeoutConstant>60000</timeoutConstant>
              <avoidCallsTo>
                <avoidCallsTo>org.slf4j</avoidCallsTo>
              </avoidCallsTo>
              <threads>4</threads>
              <timestampedReports>false</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
