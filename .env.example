# Credenciais do contêiner PostgreSQL (docker compose). Este é o usuário DONO do banco: ele cria o
# schema e é com ele que o Flyway migra. O `make up` gera o .env a partir deste arquivo sozinho.
POSTGRES_USER=omnitribo
POSTGRES_PASSWORD=omnitribo_dev
POSTGRES_DB=omnitribo

# -----------------------------------------------------------------------------------------------
# NADA ABAIXO É NECESSÁRIO EM DEV: `application-dev.yml` já traz estes defaults, e o `verify` sobe o
# banco por Testcontainers. Está aqui para descrever o que PRODUÇÃO exige — lá as variáveis não têm
# default, e a ausência derruba o boot em vez de cair num usuário mais poderoso que o devido.
# -----------------------------------------------------------------------------------------------

# Datasource da APLICAÇÃO: papel restrito, criado pela migration V2.
# Tem SELECT+INSERT nas tabelas append-only (lancamento, auditoria, checkin, missao_evento) e
# NÃO tem UPDATE nem DELETE nelas — é o que torna a imutabilidade do ledger uma garantia do BANCO,
# e não apenas disciplina do código. Também não pode criar schema, por isso o Flyway é separado.
# DATASOURCE_URL=jdbc:postgresql://localhost:5432/omnitribo
# DATASOURCE_USERNAME=omnitribo_app
# DATASOURCE_PASSWORD=troque-em-producao

# Conexão do FLYWAY: precisa de DDL, então usa o dono. Separada de propósito — dar DDL ao papel da
# aplicação anularia a proteção acima.
# FLYWAY_URL=jdbc:postgresql://localhost:5432/omnitribo
# FLYWAY_USERNAME=omnitribo
# FLYWAY_PASSWORD=troque-em-producao

# Origens permitidas em CORS. SEM default em produção: se faltar, o boot falha — o default de dev
# libera localhost, e herdá-lo em produção seria aceitar requisição de máquina de desenvolvimento.
# CORS_ORIGENS=https://app.omnitribo.example

# CIDR dos proxies confiáveis (RemoteIpValve do Tomcat). VAZIO em dev e test: sem isso,
# X-Forwarded-For é ignorado e o IP é o peer TCP real. Preencher SÓ com o endereço do proxy de
# verdade — a chave do bloqueio de login é sha256(ip+email), e confiar no header de qualquer um
# torna o bloqueio contornável com uma linha de curl.
# TRUSTED_PROXIES=10\.0\.\d+\.\d+

# Segredo HMAC do webhook de transportadora, UM POR TRANSPORTADORA. O sufixo é o slug que ela envia
# no cabeçalho X-Transportadora; a ligação relaxada do Spring o converte na chave do mapa
# app.webhooks.segredos (APP_WEBHOOKS_SEGREDOS_CORREIOS -> "correios").
#
# Sem nenhuma destas variáveis o mapa fica vazio e TODO webhook responde 401 — é a falha na direção
# segura, e é o estado do perfil default. O perfil dev traz um segredo próprio, que só serve para o
# tools/carrier-mock; nunca reaproveite aquele valor aqui.
#
# /api/v1/webhooks/** é o único ponto da API que grava sem JWT: quem tem este segredo cria missões e
# movimenta a ocupação de pontos de custódia. Trate-o como credencial de produção.
# APP_WEBHOOKS_SEGREDOS_CORREIOS=troque-em-producao
# APP_WEBHOOKS_SEGREDOS_JADLOG=troque-em-producao
