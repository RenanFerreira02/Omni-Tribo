{
	"permissions": {
		"allow": [
			"Bash(./mvnw *)",
			"Bash(npm run *)",
			"Bash(npx expo *)",
			"Bash(make *)",
			"Bash(docker compose *)",
			"Bash(git status)",
			"Bash(git diff*)",
			"Bash(git log*)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git checkout -b *)"
		],
		"deny": [
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git reset --hard*)",
			"Bash(rm -rf *)",
			"Bash(docker compose down -v*)",
			"Read(./.env)",
			"Read(./**/.env)",
			"Read(./**/google-services.json)",
			"Read(./**/*.jks)",
			"Read(./**/*.p8)",
			"Read(./**/*.keystore)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{ "matcher": "Bash", "hooks": [{ "type": "command", "command": ".claude/hooks/checar-segredo.sh" }] },
			{
				"matcher": "Write",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/guardar-migration.sh",
						"timeout": 30,
						"statusMessage": "Conferindo versão da migration..."
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/formatar-mobile.sh",
						"timeout": 30,
						"statusMessage": "Aplicando Prettier..."
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/formatar-java.sh",
						"timeout": 180,
						"statusMessage": "Aplicando Google Java Format..."
					}
				]
			}
		]
	}
}
